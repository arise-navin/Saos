PORT=4000
LOG_LEVEL=info

# Local development defaults to loopback only.
# HOST=127.0.0.1

# Render deployment
RENDER=true
SAOS_DATA_DIR=/var/data/saos
FRONTEND_ORIGIN=https://YOUR-VERCEL-APP.vercel.app
API_ACCESS_TOKEN=replace-with-a-long-random-token

# Turso values are included because this is the hosted database you provided.
# The current Node backend still uses node:sqlite; Render persistence is handled
# by the disk mounted at SAOS_DATA_DIR until the storage layer is converted.
TURSO_DATABASE_URL=libsql://saos-v2-navin-patel.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=replace-with-a-fresh-secret-token

