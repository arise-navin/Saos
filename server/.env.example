# ─────────────────────────────────────────────
# SAOS-V2 Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Turso (Cloud SQLite) ──────────────────────
# Required for Vercel deployment; optional locally (falls back to local SQLite)
TURSO_DATABASE_URL=libsql://saos-v2-navin-patel.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Ollama (Local AI) ─────────────────────────
# Ollama is already supported: set provider=ollama in Settings UI.
# These env vars are informational — configure the model in the Settings page.
# Default base URL: http://localhost:11434/v1
# Recommended models: llama3.2, qwen2.5, llama3.1

# ── Server ────────────────────────────────────
PORT=4000
# HOST defaults to 127.0.0.1 (loopback only). Do NOT change unless behind a proxy.
# HOST=127.0.0.1

# ── Logging ──────────────────────────────────
# LOG_LEVEL=info    # debug | info | warn | error
